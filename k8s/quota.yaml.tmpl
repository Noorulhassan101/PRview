apiVersion: v1
kind: ResourceQuota
metadata:
  name: preview-quota
  namespace: pr-${PR_NUMBER}
spec:
  hard:
    pods: "2"
    limits.cpu: "1"
    limits.memory: 512Mi
---
apiVersion: v1
kind: LimitRange
metadata:
  name: preview-limit-range
  namespace: pr-${PR_NUMBER}
spec:
  limits:
    - default:
        cpu: 200m
        memory: 256Mi
      defaultRequest:
        cpu: 100m
        memory: 128Mi
      type: Container
