apiVersion: apps/v1
kind: Deployment
metadata:
  name: demo-app
  namespace: pr-${PR_NUMBER}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: demo-app
  template:
    metadata:
      labels:
        app: demo-app
    spec:
      imagePullSecrets:
        - name: ghcr-secret
      securityContext:
        runAsNonRoot: true
      containers:
        - name: demo-app
          image: ghcr.io/${GHCR_USERNAME}/prview-demo:${PR_NUMBER}-${GITHUB_SHA}
          ports:
            - containerPort: 8080
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: false
          env:
            - name: PR_NUMBER
              value: "${PR_NUMBER}"
